/* 
------- Assignment-01 ------- 

Description
We want to model a concurrent system given by a lift of a building with N floors and its users.
At each floor there could be multiple users (up to M)
that want to use the lift.
The lift has a capacity of only one user at a time.
At each floor users have a button to call the lift.
Inside the lift, the user has buttons to select the floor to go.
Users getting the lift on some floor should be served in order using a first-come-first-served/FIFO policy.
An alarm signal could be generated by a fire alarm system: in that case,
the lift would interrupt current activities,
move to the ground floor, open the door and wait, until some external signal
about the alarm being solved is received.
*/

const N = 2 
const M = 2
range FLOORS=0..N
range USERS=0..M

// QUEUE in a level
QUEUE = SLOT[0],
SLOT[i:USERS] = (
    when (i < M) call -> WAIT[i]
    |alarm -> WAITING_RESOLVE[i]
),
// USER in the head of the queue pressed button and is waiting
WAIT[i:0..M-1] = (
    wait -> ENTERING[i]	// elevator is coming to the level
    |enter -> SELECT[i]			// elevator is already at the level
    |alarm -> WAITING_RESOLVE[i]
),
// USER enters the elevator
ENTERING[i:0..M-1] = (
    enter -> SELECT[i]	// Select the target level
    |alarm -> WAITING_RESOLVE[i]
),
SELECT[i:0..M-1] = (
    select_level[to:FLOORS] -> MOVING[i][to] // The elevator is moving with the user inside
    |alarm -> ALARM_MOVING[i]
),
// ELEVATOR moving the user to the floor 'to'
MOVING[from:0..M-1][to:FLOORS] = (
    move[to] -> exit[to] -> SLOT[from+1] // User exited the lift the next in queue is waiting
    |alarm -> ALARM_MOVING[from]
),
// allarme con utente in cabina: l'ascensore lo riporta a piano 0
ALARM_MOVING[from:0..M-1] = (
    move[0] -> exit[0] -> WAITING_RESOLVE[from+1]
),
// An allarm was activated, no user can call for the elevator
WAITING_RESOLVE[i:USERS] = (resolve -> SLOT[i]).

// ELEVATOR starting from ground level
ELEVATOR = IDLE[0],
IDLE[i:FLOORS] = (
    s[tmp:FLOORS].move_empty -> LOADING[tmp]    // someone called the elevator and is waiting, move to the level
	|s[i].enter -> IN_CABIN[i]                  // someone is waiting at the i level, directly enter the elevator
	|alarm -> ALARM_ELEVATOR
),
// The USER is entering the lift at the level i
LOADING[i:FLOORS] = (
	s[i].enter -> IN_CABIN[i]
	|alarm -> ALARM_ELEVATOR
),
// User is inside and the elevator is moving
IN_CABIN[i:FLOORS] = (
	s[i].move[to:FLOORS] -> s[i].exit[to] -> IDLE[to]
	|alarm -> ALARM_ELEVATOR_FULL[i]
),
// User is inside and the alarm triggers
ALARM_ELEVATOR_FULL[i:FLOORS] = (
    s[i].move[0] -> open_door -> s[i].exit[0] -> AWAIT_SIGNAL
),
// Elevator is empty and the alarm triggers
ALARM_ELEVATOR = (move -> open_door -> AWAIT_SIGNAL),
AWAIT_SIGNAL = (resolve -> IDLE[0]).

// Elevator state
NORMAL = (
    alarm -> ALARM
),
// Alarm activated
ALARM = (resolve -> NORMAL).

||BUILDING = (
    s[i:0..M]:QUEUE
    || ELEVATOR
    || NORMAL
) / { alarm/s[j:0..M].alarm, resolve/s[k:0..M].resolve, wait/move_empty }.

// FLUENTS
const False = 0
const True = 1

// A user at the f floor has called the lift and is waiting
fluent CALLING[f:0..N] = <s[f].call, s[f].enter> initially False

// A user is inside the lift
fluent IN_CABIN[i:0..N] = <s[i].enter, s[i].exit[to:0..N]> initially False

// A user has entered and selected a destination
fluent TARGET_SELECTED[to:0..N] = <s[i:0..N].select_level[to], s[j:0..N].exit[to]> initially False

// A generic user waiting in line
// fluent GENERIC_USER[l:0..N][u:0..M] = <s[l].enter, s[l].call> initially False

// ALARM is active between these two actions
fluent ALARM = <alarm, resolve> initially False

// FLTL Properties (ASSERTIONS)
// Property 1: "Only one user at a time should be using the lift"
// Mutual Exclusion: verifiable by checking all the IN_CABIN pairs and ensuring no pair (true, true) exists
assert MUTEX_CABIN = [] forall[i:0..N] forall[d:1..N] !(IN_CABIN[i] && IN_CABIN[(i+d)%(N+1)])

// Property 2: "If a user is calling the lift, the lift will eventually arrive (but in alarm case)"
// Liveness: If a user calls the lift at level f it will eventually arrive, checked by asserting that the user enters the elevator.
assert LIVENESS_CALL = forall[f:0..N] [](CALLING[f] -> <>(s[f].enter || ALARM))

// Property 3: "If a user inside the lift select a floor, he/she would finally arrive at the floor (but in the alarm case)"
// Liveness: Checked by asserting that either the user exits at the correct level or the alarm becomes true
assert LIVENESS_DELIVERY = forall[to:0..N] [](TARGET_SELECTED[to] -> <>(s[i:0..N].exit[to] || ALARM))